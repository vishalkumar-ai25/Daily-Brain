# Daily Brain — Environment Variables
# Copy this file to .env and fill in your values.
# On Railway: set these in the Railway dashboard → Variables tab.
# NEVER commit the actual .env file to git.

# Which LLM to use: "ollama" | "gemini" | "openai"
LLM_PROVIDER=ollama

# If LLM_PROVIDER=ollama:
# For local:    OLLAMA_HOST=http://localhost:11434
# For Railway:  set to your public Ollama URL (e.g. via ngrok or a public server)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# If LLM_PROVIDER=gemini: your Google Gemini API key
GEMINI_API_KEY=

# If LLM_PROVIDER=openai: your OpenAI API key
OPENAI_API_KEY=
